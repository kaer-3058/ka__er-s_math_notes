%% 代码语言：mermaid
%% 可在如下网站运行：https://mermaid.live/

flowchart TD
    %% 1. 节点定义
    Start([开始])
    Input[/输入一元N次方程系数/]
    P1["降阶算法：简单检查是否有<br/>0作为根"]
    P2["将最高项系数化为1，得到系<br/>数向量b"]
    P3["构造上Hessenberg形式的友<br/>矩阵A0"]
    
    D1{"是否满足收敛条件？"}
    
    P4["提取结果"]
    P4_1[/"对角线元素=实根"/]
    P4_2[/"2x2子块=共轭复根对"/]
    
    P5["牛顿迭代法精细化求根"]
    P6["若其中有根对应的导数值过<br/>小，可考虑换成割线法"]
    
    D2{"三步检查法检查根：原方程<br/>代入（零值检验）、导数与重<br/>根检验、牛顿迭代步进差"}
    
    End([结束])
    
    P7["计算位移值 Wilkinson Shift"]
    P8["如果位移值不为大于1/2的<br/>实数，则按一定频率，把它<br/>设置为1/2，是为防止迭代<br/>意外卡死的强制位移"]
    
    D3{"是否程序环境的浮点数计算<br/>精度较高"}
    
    P9_1["如果位移值为实数，则位<br/>移，如果是复数，则执行<br/>Francis隐式双位移"]
    P9_2["如果位移值为实数，则位<br/>移，如果是复数，则选<br/>a_{n, n}的值作为位移量"]
    
    P10["执行QR分解：左乘Givens<br/>旋转矩阵消除次对角线"]
    P11["执行相似变换：右乘Givens<br/>转置矩阵以保持特征值"]
    P12["加速策略：划分与收缩"]
    
    D4{"是否成功划分"}
    
    P13["假设收敛检验：是否存在<br/>任意两个相邻的次对角线元<br/>素都不趋于0"]
    P14["停止当前循环，为划分出来<br/>的子块分别开一个新的循环"]

    %% 2. 关系连线
    Start --> Input
    Input --> P1
    P1 --> P2
    P2 --> P3
    P3 --> D1
    
    %% 满足收敛条件分支（提取结果）
    D1 -- 是 --> P4
    P4 --> P4_1
    P4 --> P4_2
    P4_1 --> P5
    P4_2 --> P5
    
    P5 --> P6
    P5 --> D2
    P6 --> D2
    
    D2 -- 检查通过 --> End
    
    %% 未满足收敛条件 / 检查不通过 -> 进入位移计算
    D1 -- 否 ----> P7
    D2 -- 检查不通过 --> P7
    
    %% 主迭代循环内部
    P7 --> P8
    P8 --> D3
    P14 ----> P7
    
    D3 -- 是 --> P9_1
    D3 -- 否 --> P9_2
    
    P9_1 --> P10
    P9_2 --> P10
    
    P10 --> P11
    P11 --> P12
    P12 --> D4
    
    D4 -- 否 --> P13
    D4 -- 是 --> P14
    
    P13 ----> D1

    %% 3. 样式定义与应用
    classDef startEnd fill:#f9f,stroke:#333,stroke-width:2px,rx:15,ry:15;
    classDef io fill:#d0f0fd,stroke:#333,stroke-width:1px;
    classDef process fill:#e1d5e7,stroke:#9673a6,stroke-width:1px;
    classDef decision fill:#fff2cc,stroke:#d6b656,stroke-width:1px;

    class Start,End startEnd;
    class Input,P4_1,P4_2 io;
    class P1,P2,P3,P4,P5,P6,P7,P8,P9_1,P9_2,P10,P11,P12,P13,P14 process;
    class D1,D2,D3,D4 decision;
